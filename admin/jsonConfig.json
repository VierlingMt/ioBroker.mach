          "sm": 12,
          "md": 6,
          "lg": 5,
          "default": ""
        },
        "password": {
          "type": "password",
          "label": "Password",
          "repeat": false,
          "sm": 12,
          "md": 6,
          "lg": 5,
          "default": ""
        },
        "machId": {
          "type": "text",
          "label": "machId (12 Hex-Zeichen)",
          "newLine": true,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "default": ""
        },
        "_status": {
          "type": "staticText",
          "text": "Liest alle Werte der Box (values.*), beim Verbinden, alle 15 Minuten und kurz nach jeder Änderung. Schreiben: Heizung an/aus (named.Heizung_Schalter) und Sollwert (named.Heizung_Sollwert). Inoffizieller Adapter, nicht von Adria oder Solvesall.",
          "newLine": true
        }
      }
