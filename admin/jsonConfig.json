{
  "i18n": true,
  "type": "tabs",
  "items": {
    "options": {
      "type": "panel",
      "label": "Settings",
      "items": {
        "_header": {
          "type": "header",
          "text": "MACH account",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_hint": {
          "type": "staticText",
          "text": "Enter the login of your MACH app. The machId is shown in the app under device settings (12 hex characters, e.g. A1B2C3D4E5F6).",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "username": {
          "type": "text",
          "label": "Username (e-mail)",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 5,
          "xl": 5,
          "default": ""
        },
        "password": {
          "type": "password",
          "label": "Password",
          "repeat": false,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 5,
          "xl": 5,
          "default": ""
        },
        "machId": {
          "type": "text",
          "label": "machId (12 hex characters)",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 4,
          "xl": 4,
          "default": ""
        },
        "_status": {
          "type": "staticText",
          "text": "Reads all values of the box (values.*): at connect, every 15 minutes and on every change. What can be switched is set under \"Write access\". Unofficial adapter, not made by Adria or Solvesall.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "_headerWrite": {
          "type": "header",
          "text": "Write access",
          "size": 4,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "schreiben": {
          "type": "select",
          "label": "Write access",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 5,
          "xl": 5,
          "default": "bedienung",
          "options": [
            {
              "label": "off – read only",
              "value": "aus"
            },
            {
              "label": "operation – heating, climate, fridge, lights, pump, boiler (recommended)",
              "value": "bedienung"
            },
            {
              "label": "setup – also sensor pairing, limits and names (experts)",
              "value": "einrichtung"
            }
          ]
        },
        "eigeneFreigaben": {
          "type": "text",
          "label": "Additionally writable (names, * allowed, comma separated)",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 10,
          "xl": 10,
          "default": "",
          "minRows": 2,
          "maxRows": 6
        },
        "eigeneSperren": {
          "type": "text",
          "label": "Never writable (names, * allowed, comma separated)",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 10,
          "xl": 10,
          "default": "",
          "minRows": 2,
          "maxRows": 6
        },
        "_hintWrite": {
          "type": "staticText",
          "text": "Writable values appear under values.* as switch, slider or selection. Names are the ones under values.*, e.g. FRIDGE_VALUE or LIGHT_GROUP_*. Values that could cut the LTE connection or brick the box (LTE on/off, SIM settings, bootloader, debug) can never be written.",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    }
  }
}
